{
  "name": "fh",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "dev": "expo start --dev-client",
    "dev:tunnel": "expo start --dev-client --tunnel",
    "dev-client": "expo start --dev-client",
    "dev-client:tunnel": "expo start --dev-client --tunnel",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev": "npx --yes eas-cli build --profile development --platform android",
    "build:preview": "npx --yes eas-cli build --profile preview --platform android",
    "build:prod": "npx --yes eas-cli build --profile production --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/native-stack": "^7.14.6",
    "expo": "~55.0.8",
    "expo-camera": "~55.0.10",
    "expo-document-picker": "~55.0.17",
    "expo-image-picker": "~55.0.13",
    "expo-speech": "~55.0.9",
    "expo-speech-recognition": "^3.1.2",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
